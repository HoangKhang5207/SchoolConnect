# ==============================================================================
# SchoolConnect — Environment Configuration Template (.env.example)
# Copy this file to .env for local overrides. NEVER commit real secrets to Git.
# ==============================================================================

# --- 1. Backend Server Configuration ---
SERVER_PORT=8080
SPRING_PROFILES_ACTIVE=dev

# --- 2. PostgreSQL Database Configuration ---
DB_HOST=localhost
DB_PORT=5432
DB_NAME=schoolconnect
DB_URL=jdbc:postgresql://localhost:5432/schoolconnect
DB_USERNAME=postgres
DB_PASSWORD=CHANGE_ME_LOCAL_DEV_PASSWORD

# --- 3. Security & JWT Configuration ---
# Must be at least 32 characters (256 bits) for HMAC-SHA256 signing
JWT_SECRET=CHANGE_ME_WITH_AT_LEAST_32_CHARS_RANDOM_SECRET_KEY_FOR_HS256
JWT_EXPIRATION_MS=86400000

# --- 4. Dual Authentication & Zalo Mini App Configuration ---
# Set APP_AUTH_DEMO_MODE=true for instant demo session & Parent/Teacher role switching
APP_AUTH_DEMO_MODE=true
ZALO_APP_ID=YOUR_ZALO_MINI_APP_ID
ZALO_APP_SECRET=YOUR_ZALO_APP_SECRET_FOR_HMAC_PROOF
ZALO_GRAPH_API_URL=https://graph.zalo.me/v2.0/me

# --- 5. CORS Configuration (Includes Zalo Mini App Container Origin) ---
CORS_ALLOWED_ORIGINS=https://h5.zdn.vn,http://localhost:3000,http://localhost:5173

# --- 6. Frontend Vite / ZMP Configuration ---
VITE_API_BASE_URL=http://localhost:8080/api/v1
VITE_DEFAULT_AUTH_MODE=DEMO_MODE
VITE_ZALO_APP_ID=YOUR_ZALO_MINI_APP_ID

